# Platform Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
API_HOST=0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback in dev)
DATABASE_URL=sqlite:///./inference_platform.db
# DATABASE_URL=postgresql://user:password@localhost:5432/inference

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_FALLBACK_MEMORY=true

# Authentication & Security
AUTH_ENABLED=true
DEFAULT_MASTER_KEY=ai_live_master_key_999999
FREE_TIER_RPM=100
PREMIUM_TIER_RPM=10000

# Dynamic Batching Configuration
MAX_BATCH_SIZE=16
MAX_WAIT_MS=20

# Worker Configuration
WORKER_DEVICE=cpu
WORKER_ID=worker_node_1
MODEL_STORAGE_DIR=./model_artifacts
